# Keycloak-demo URL/port configuration — QA environment (example/template).
#
# Same keys as urls.dev.env, retargeted to QA hosts (real DNS + TLS via the
# ingress, like prod). Fill in the actual QA hostnames below. See urls.dev.env
# for the full explanation of the two consumers (app-urls ConfigMap +
# reconcile-realm.sh).

# ============================ [APP] token-handler/BFF env ====================
KEYCLOAK_ISSUER=https://auth.qa.geowealth.int/realms/demo-realm
KEYCLOAK_AUTH_SERVER_URL=http://keycloak:8080/realms/demo-realm
P1_AUTHZ_URL=http://p1-tomcat:8080
# After auth-extraction P1 is an OIDC RP; logout endpoint is /oidc/logout.
APP_P1_INITIATE_SLO_URL=https://p1.qa.geowealth.int/oidc/logout

# ============================ [REALM] reconcile-realm.sh =====================
KC_ADMIN_BASE=https://auth.qa.geowealth.int
KC_REALM=demo-realm
P1_INCLUSTER_BASE=http://p1-tomcat:8080
SPA_HOSTS=https://billing.qa.geowealth.int https://trading.qa.geowealth.int https://p1.qa.geowealth.int
P1_CALLBACK_HOSTS=https://p1.qa.geowealth.int
TH_BACKCHANNEL_URL=http://token-handler:8080/backchannel-logout
