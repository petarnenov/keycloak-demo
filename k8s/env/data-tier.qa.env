# Data-tier endpoint config — QA environment (example/template).
#
# Same keys as data-tier.dev.env, retargeted to external QA hosts. Replace the
# hostnames below with the actual QA Oracle / Elasticsearch / Memcached you want
# this cluster to talk to. See data-tier.dev.env for the full explanation of the
# in-cluster vs external semantics and the "no seeding for externals" rule.
#
#   DATA_TIER_ENV=k8s/env/data-tier.qa.env ./k8s/up.sh
#
# Reminder: the external hosts must listen on the SAME ports the in-cluster
# Services exposed (1521 / 9200 / 11211). ExternalName services don't remap
# ports. And nothing in this cluster will seed any of these — bring them
# already populated (for Oracle: `docker run keycloak-demo-db:seeded` on the
# target host is the fast path).

ORACLE_HOST=oracle.qa.geowealth.int
ORACLE_PORT=1521

ELASTICSEARCH_HOST=elastic.qa.geowealth.int
ELASTICSEARCH_PORT=9200

MEMCACHED_HOST=memcached.qa.geowealth.int
MEMCACHED_PORT=11211
