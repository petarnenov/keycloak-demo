# Keycloak-demo URL/port configuration — PROD environment (example/template).
#
# Same keys as urls.dev.env, retargeted to production hosts. In prod everything is
# behind real DNS + TLS on standard ports (443) served by the ingress — no
# :5180 / :8080 port-forward and no loopback variants. See urls.dev.env for the
# full explanation of the two consumers (app-urls ConfigMap + reconcile-realm.sh).

# ============================ [APP] token-handler/BFF env ====================
KEYCLOAK_ISSUER=https://auth.geowealth.int/realms/demo-realm
KEYCLOAK_AUTH_SERVER_URL=http://keycloak:8080/realms/demo-realm
P1_AUTHZ_URL=http://p1-tomcat:8080
APP_P1_INITIATE_SLO_URL=https://p1.geowealth.int/saml/idp/initiate-slo.do

# ============================ [REALM] reconcile-realm.sh =====================
KC_ADMIN_BASE=https://auth.geowealth.int
KC_REALM=demo-realm
P1_BROWSER_BASE=https://p1.geowealth.int
P1_INCLUSTER_BASE=http://p1-tomcat:8080
SPA_HOSTS=https://billing.geowealth.int https://trading.geowealth.int
P1_CALLBACK_HOSTS=https://p1.geowealth.int
TH_BACKCHANNEL_URL=http://token-handler:8080/backchannel-logout
