# Data-tier endpoint config — PROD environment (example/template).
#
# Same keys as data-tier.dev.env, retargeted to external production hosts.
# Replace the hostnames below with the actual prod Oracle / Elasticsearch /
# Memcached. See data-tier.dev.env for the full explanation of the in-cluster
# vs external semantics and the "no seeding for externals" rule.
#
#   DATA_TIER_ENV=k8s/env/data-tier.prod.env ./k8s/up.sh
#
# Reminder: external hosts must listen on the same ports the in-cluster
# Services used (1521 / 9200 / 11211). ExternalName services don't remap
# ports. Nothing in this cluster will seed any of these.

ORACLE_HOST=oracle.geowealth.int
ORACLE_PORT=1521

ELASTICSEARCH_HOST=elastic.geowealth.int
ELASTICSEARCH_PORT=9200

MEMCACHED_HOST=memcached.geowealth.int
MEMCACHED_PORT=11211
