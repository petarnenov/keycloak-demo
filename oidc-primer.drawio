                    </mxGeometry>
                </mxCell>
                <mxCell id="s16l" value="16) GET /oauth/callback/keycloak?code=ABC&amp;state=eyJ…" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=11;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="220" y="988" width="320" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="s17box" value="17) BFF validates state matches server-stored value&#xa;(rejects if tampered or stale)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fff0;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=10;spacingTop=5" parent="1" vertex="1">
                    <mxGeometry x="430" y="1035" width="320" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="s18" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;strokeColor=#206020" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="540" y="1100" as="sourcePoint"/>
                        <mxPoint x="910" y="1100" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="s18l" value="18) POST KC /token (grant_type=authorization_code, code, code_verifier, client_id)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=11;fontStyle=1;fontColor=#206020" parent="1" vertex="1">
                    <mxGeometry x="430" y="1078" width="600" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="s19box" value="19) KC validates PKCE: SHA256(code_verifier) == code_challenge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffdf0;strokeColor=#d6b656;fontSize=10;align=center" parent="1" vertex="1">
                    <mxGeometry x="800" y="1125" width="380" height="35" as="geometry"/>
                </mxCell>
                <mxCell id="s20" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;dashed=1;strokeColor=#206020" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="910" y="1185" as="sourcePoint"/>
                        <mxPoint x="540" y="1185" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="s20l" value="20) 200 { access_token, id_token, refresh_token, expires_in }" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=11;fontColor=#206020" parent="1" vertex="1">
                    <mxGeometry x="500" y="1195" width="460" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="s21box" value="21) BFF stores tokens in server-side session (Authentication.attributes)&#xa;       Sets BSESSION httpOnly cookie on browser" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fff0;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=10;spacingTop=5" parent="1" vertex="1">
                    <mxGeometry x="430" y="1225" width="380" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="s22" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;dashed=1" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="540" y="1310" as="sourcePoint"/>
                        <mxPoint x="190" y="1310" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="s22l" value="22) 302 Location: /  +  Set-Cookie: BSESSION=…" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=11" parent="1" vertex="1">
                    <mxGeometry x="220" y="1320" width="320" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="s23" style="endArrow=classic;html=1;rounded=0;strokeWidth=2" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="190" y="1370" as="sourcePoint"/>
                        <mxPoint x="540" y="1370" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="s23l" value="23) SPA mounts → GET /auth/me (BSESSION cookie)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=11;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="220" y="1348" width="320" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="s24" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;dashed=1;strokeColor=#206020" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="540" y="1400" as="sourcePoint"/>
                        <mxPoint x="190" y="1400" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="s24l" value="24) 200 { username, email, firmCd, roles }" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=11;fontColor=#206020" parent="1" vertex="1">
                    <mxGeometry x="240" y="1410" width="280" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="final" value="✓ Dashboard rendered. The SPA carries no tokens — only the httpOnly BSESSION cookie.&#xa;Subsequent API calls reuse the session; the BFF refreshes tokens server-side before they expire." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f7e6;strokeColor=#206020;fontSize=12;fontStyle=1;align=center" parent="1" vertex="1">
                    <mxGeometry x="100" y="1460" width="1200" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="seqlegend" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666;align=left;verticalAlign=top" parent="1" vertex="1">
                    <mxGeometry x="100" y="1550" width="1200" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="seqlegend1" value="━━━ request   ┄┄┄ response (dashed)   green ⟶ OIDC server-to-server   red ⟶ SAML hops   black ⟶ browser navigations" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=11;fontStyle=2" parent="1" vertex="1">
                    <mxGeometry x="100" y="1560" width="1200" height="30" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="tokens" name="Tokens">
        <mxGraphModel dx="741" dy="503" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="tok_title" value="The Three OIDC Tokens — where they live, what they&#39;re for" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="100" y="30" width="1200" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="tok_at" value="access_token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontStyle=1;align=center;verticalAlign=top;spacingTop=10" parent="1" vertex="1">
                    <mxGeometry x="80" y="120" width="380" height="540" as="geometry"/>
                </mxCell>
                <mxCell id="tok_at_body" value="Format: JWT (RS256, in Keycloak)&#xa;&#xa;Purpose: Authorization to resource&#xa;servers — &quot;I&#39;m allowed to call /api/foo&quot;&#xa;&#xa;Lifetime: short (~5 min default)&#xa;&#xa;Where it lives:&#xa;• In the BFF&#39;s server-side session&#xa;• Forwarded to P1 as Bearer when&#xa;     the BFF calls P1 as the user&#xa;     (see UsersController, P1AuthzClient)&#xa;&#xa;Stored claims (subset):&#xa;• iss, sub, aud, exp, iat&#xa;• azp (authorized party)&#xa;• scope: openid profile email&#xa;• realm_access.roles&#xa;• firmCd&#xa;&#xa;NEVER reaches the browser." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacingLeft=20;spacingTop=10" parent="1" vertex="1">
                    <mxGeometry x="80" y="150" width="380" height="510" as="geometry"/>
                </mxCell>
                <mxCell id="tok_it" value="id_token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;fontStyle=1;align=center;verticalAlign=top;spacingTop=10" parent="1" vertex="1">
                    <mxGeometry x="500" y="120" width="380" height="540" as="geometry"/>
                </mxCell>
                <mxCell id="tok_it_body" value="Format: JWT (RS256) — always.&#xa;&#xa;Purpose: Authentication proof —&#xa;&quot;here&#39;s who I am and when I&#xa;authenticated&quot;.&#xa;&#xa;Lifetime: short (~30 min); refreshed&#xa;along with access_token.&#xa;&#xa;Where it lives:&#xa;• In the BFF&#39;s server-side session&#xa;• Sent to KC as id_token_hint on&#xa;     OIDC end-session (RP-initiated&#xa;     logout) — when that works&#xa;&#xa;Standard claims:&#xa;• iss, sub, aud, exp, iat&#xa;• auth_time (original auth time)&#xa;• nonce (anti-replay, matches /authorize)&#xa;• sid (KC SSO session id)&#xa;• preferred_username, email, name&#xa;• Custom: firmCd, roles" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacingLeft=20;spacingTop=10" parent="1" vertex="1">
                    <mxGeometry x="500" y="150" width="380" height="510" as="geometry"/>
                </mxCell>
                <mxCell id="tok_rt" value="refresh_token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;fontStyle=1;align=center;verticalAlign=top;spacingTop=10" parent="1" vertex="1">
                    <mxGeometry x="920" y="120" width="380" height="540" as="geometry"/>
                </mxCell>
                <mxCell id="tok_rt_body" value="Format: opaque (or JWT in KC).&#xa;&#xa;Purpose: Exchange for a fresh&#xa;access_token + id_token before&#xa;they expire — without re-prompting&#xa;the user.&#xa;&#xa;Lifetime: longer (hours to days).&#xa;&#xa;Where it lives:&#xa;• In the BFF&#39;s server-side session&#xa;• Used by TokenRefreshFilter when&#xa;     access_token is within 60s of&#xa;     expiry: POST /token with&#xa;     grant_type=refresh_token&#xa;&#xa;Security notes:&#xa;• Single-use (KC rotates on each use)&#xa;• Revoked at logout via the OIDC&#xa;     revocation / back-channel logout&#xa;     endpoints&#xa;• NEVER reaches the browser.&#xa;&#xa;Standard claims (when JWT):&#xa;• iss, sub, aud, exp, iat, jti, sid, azp" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacingLeft=20;spacingTop=10" parent="1" vertex="1">
                    <mxGeometry x="920" y="150" width="380" height="510" as="geometry"/>
                </mxCell>
                <mxCell id="tok_rule" value="The Token Handler / BFF rule: not a single token ever reaches the browser. Only the httpOnly BSESSION cookie does." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8dc;strokeColor=#d6b656;fontSize=14;fontStyle=1;align=center" parent="1" vertex="1">
                    <mxGeometry x="80" y="700" width="1220" height="60" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="logout" name="Logout Flows">
        <mxGraphModel dx="741" dy="503" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="logt" value="OIDC Logout Flows — three standards, plus the one this demo actually uses" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="100" y="30" width="1200" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="c1" value="1) RP-Initiated Logout&#xa;(OIDC spec)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;align=center;verticalAlign=top;spacingTop=10" parent="1" vertex="1">
                    <mxGeometry x="40" y="100" width="320" height="640" as="geometry"/>
                </mxCell>
                <mxCell id="c1body" value="Browser redirect:&#xa;&#xa;/protocol/openid-connect/logout?&#xa;  id_token_hint=…&#xa;  client_id=…&#xa;  post_logout_redirect_uri=…&#xa;&#xa;KC validates id_token_hint:&#xa;• signature against JWKS&#xa;• sid claim matches an active&#xa;     KC user_session&#xa;&#xa;If valid:&#xa;• KC ends the SSO session&#xa;• KC fires SAML SLO to P1&#xa;     (via browser auto-submit)&#xa;• Browser redirected back to&#xa;     post_logout_redirect_uri&#xa;&#xa;If invalid:&#xa;• KC renders &quot;Do you want&#xa;     to log out?&quot; confirm page&#xa;• User must click through&#xa;&#xa;⚠ In this demo: the stored&#xa;id_token&#39;s sid drifts from&#xa;KC&#39;s current session as KC&#xa;rotates it (refresh, silent&#xa;re-auth). The confirm page&#xa;triggers reliably." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacingLeft=15;spacingTop=10" parent="1" vertex="1">
                    <mxGeometry x="40" y="140" width="320" height="600" as="geometry"/>
                </mxCell>
                <mxCell id="c2" value="2) Front-Channel Logout&#xa;(OIDC spec)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;align=center;verticalAlign=top;spacingTop=10" parent="1" vertex="1">
                    <mxGeometry x="380" y="100" width="320" height="640" as="geometry"/>
                </mxCell>
                <mxCell id="c2body" value="When the KC SSO session ends:&#xa;&#xa;KC renders an HTML page with&#xa;one &lt;iframe&gt; per registered&#xa;client (each with its own&#xa;frontchannel.logout.url).&#xa;&#xa;Each iframe loads on the&#xa;client&#39;s own origin → JS can&#xa;clean up same-origin state.&#xa;&#xa;In this demo:&#xa;• domains/&lt;name&gt;/web/public/&#xa;     frontchannel-logout.html&#xa;     wipes auth-prefixed&#xa;     localStorage keys&#xa;• Broadcasts via&#xa;     BroadcastChannel(&#39;auth&#39;)&#xa;     so any open SPA tab on&#xa;     the same origin reloads&#xa;&#xa;Best-effort, not authoritative.&#xa;Mostly useful for clearing UI&#xa;state in still-open tabs." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacingLeft=15;spacingTop=10" parent="1" vertex="1">
                    <mxGeometry x="380" y="140" width="320" height="600" as="geometry"/>
                </mxCell>
                <mxCell id="c3" value="3) Back-Channel Logout&#xa;(OIDC BCL 1.0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;align=center;verticalAlign=top;spacingTop=10" parent="1" vertex="1">
                    <mxGeometry x="720" y="100" width="320" height="640" as="geometry"/>
                </mxCell>
                <mxCell id="c3body" value="Server-to-server (no browser):&#xa;&#xa;KC POSTs a logout_token (JWT)&#xa;to each client&#39;s registered&#xa;backchannel.logout.url.&#xa;&#xa;Receiver (BFF) validates:&#xa;• signature against JWKS&#xa;• iss == KC issuer&#xa;• aud contains client_id&#xa;• events claim has the&#xa;     backchannel-logout event&#xa;• typ header = logout+jwt&#xa;• returns sid claim&#xa;&#xa;In this demo:&#xa;• LogoutTokenValidator does&#xa;     all of the above&#xa;• BackchannelLogoutController&#xa;     receives the POST&#xa;• SidSessionRegistry maps&#xa;     OIDC sid → BFF session id&#xa;     so we destroy the right&#xa;     server-side session&#xa;&#xa;Most reliable mechanism for&#xa;out-of-band logout (P1 logout&#xa;triggers KC SLO triggers this)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacingLeft=15;spacingTop=10" parent="1" vertex="1">
                    <mxGeometry x="720" y="140" width="320" height="600" as="geometry"/>
                </mxCell>
                <mxCell id="c4" value="4) P1 IdP-Initiated SLO&#xa;(this demo&#39;s actual route)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1;align=center;verticalAlign=top;spacingTop=10" parent="1" vertex="1">
                    <mxGeometry x="1060" y="100" width="320" height="640" as="geometry"/>
                </mxCell>
                <mxCell id="c4body" value="Workaround for a P1-side bug:&#xa;cross-port SAML LogoutRequest&#xa;from KC loses JSESSIONID, so&#xa;P1 can&#39;t identify the session&#xa;to invalidate and silently does&#xa;nothing → P1 stays logged in&#xa;and the next authorize silently&#xa;re-auths the user.&#xa;&#xa;BFF /auth/logout:&#xa;1. Deletes its own session&#xa;2. Invalidates SidSessionRegistry&#xa;3. 303 → http://localhost:8888/&#xa;     saml/idp/initiate-slo.do&#xa;&#xa;P1 IdpInitiateSloAction:&#xa;1. Runs same-origin →&#xa;     reads JSESSIONID&#xa;2. Invalidates P1 HttpSession&#xa;3. Builds signed SAML&#xa;     LogoutRequest&#xa;4. Returns HTML auto-submit&#xa;     POST form → KC broker SLO&#xa;&#xa;KC ends its session and sends&#xa;LogoutResponse back to P1.&#xa;P1 lands the user on its login&#xa;form.&#xa;&#xa;Trade-off: URL bar ends at&#xa;localhost:8888, not the SPA." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacingLeft=15;spacingTop=10" parent="1" vertex="1">
                    <mxGeometry x="1060" y="140" width="320" height="600" as="geometry"/>
                </mxCell>
                <mxCell id="bnote" value="Standards 1–3 are part of the OIDC family. Route #4 is a non-standard workaround for a P1-side SAML SLO bug — fixing P1 (back-channel SAML SLO, or session correlation by NameID) lets route #1 work cleanly and removes the URL-bar discontinuity." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f8ff;strokeColor=#6c8ebf;fontSize=12;fontStyle=2;align=center;verticalAlign=middle;spacingLeft=15;spacingRight=15" parent="1" vertex="1">
                    <mxGeometry x="40" y="780" width="1340" height="70" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>