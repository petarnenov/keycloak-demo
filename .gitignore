# macOS
.DS_Store

# Node
node_modules/
*.tsbuildinfo

# Frontend build output (each Vite workspace emits its own dist/)
frontend/apps/*/dist/
domains/*/web/dist/

# npm install artifact — package.json is tracked, lock file is regenerated
# locally and intentionally not part of the repo (matches existing practice
# in this codebase).
domains/*/web/package-lock.json

# Private keys (mkcert-issued or otherwise). Regenerate locally with mkcert
# per the demo-billing setup notes in CLAUDE.md.
proxy/certs/*.key
*.pem

# Gradle
.gradle/
build/
bin/

# IDE
.idea/
.vscode/
*.iml

# Local env (contains secrets). Copy .envrc.example to get started.
.envrc


#AI
.claude

# Ephemeral Playwright MCP artifacts (per-run snapshots/screenshots).
.playwright-mcp/


# Playwright runner state (root-level, distinct from e2e/test-results)
/test-results/

# Local-only flyway location: dev secrets (password hashes) — never commit
db/local/
