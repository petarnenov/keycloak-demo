{
  "id": "geowealth-realm",
  "realm": "geowealth-realm",
  "enabled": true,
  "displayName": "GeoWealth",
  "loginTheme": "geowealth-wl",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "internationalizationEnabled": true,
  "supportedLocales": ["en"],
  "defaultLocale": "en",
  "browserFlow": "browser",
  "clients": [
    {
      "clientId": "geowealth-poc-client",
      "enabled": true,
      "name": "GeoWealth POC Client",
      "description": "Public OIDC client for the white-labeling POC demo app at :5174. Subdomain-routed (changepath.localhost / default.localhost).",
      "publicClient": true,
      "bearerOnly": false,
      "webOrigins": [
        "http://localhost:5174",
        "http://127.0.0.1:5174",
        "http://changepath.localhost:5174",
        "http://default.localhost:5174"
      ],
      "redirectUris": [
        "http://localhost:5174/*",
        "http://127.0.0.1:5174/*",
        "http://changepath.localhost:5174/*",
        "http://default.localhost:5174/*"
      ],
      "baseUrl": "http://localhost:5174/",
      "rootUrl": "http://localhost:5174",
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "protocolMappers": [
        {
          "name": "realm-roles-flat",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "poc-user",
      "email": "poc-user@example.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "POC",
      "lastName": "User",
      "credentials": [
        { "type": "password", "value": "123", "temporary": false }
      ]
    }
  ]
}
