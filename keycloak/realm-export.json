  "defaultRole": {
    "name": "default-roles-demo-realm",
    "description": "${role_default-roles}",
    "composite": true,
    "clientRole": false
  },
  "roles": {
    "realm": [
      {
        "name": "default-roles-demo-realm",
        "description": "${role_default-roles}",
        "composite": true,
        "composites": {
          "client": {
            "account": [
              "view-profile",
              "manage-account"
            ]
          }
        }
      },
      {
        "name": "client",
        "description": "Coarse capability: end-client of the firm (limited self-service)."
      },
      {
        "name": "advisor",
        "description": "Coarse capability: P1 advisor seat (read+act on client accounts within the firm)."
      },
      {
        "name": "admin",
        "description": "Coarse capability: back-office admin (firm-scoped admin powers)."
      },
      {
        "name": "billing-admin",
        "description": "Per-domain capability: write access to the billing domain (manage invoices, plans, payment methods)."
      },
      {
        "name": "billing-viewer",
        "description": "Per-domain capability: read-only access to the billing domain."
      },
      {
        "name": "trading-trader",
        "description": "Per-domain capability: place and manage orders in the trading domain."
      },
      {
        "name": "trading-viewer",
        "description": "Per-domain capability: read-only access to the trading domain (portfolio/positions/orders)."
      },
      {
        "name": "gwAdmin",
        "description": "Global cross-firm override (P1 gwAdminFlag). The BFF applies it as 'gwAdmin || hasX()', mirroring P1's call-site 'gwAdmin || canX()' convention."
      }
    ]
  },
