{
  "id": "demo-realm",
  "realm": "demo-realm",
  "enabled": true,
  "displayName": "Demo SSO Realm",
  "loginTheme": "mfe-shell",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "browserFlow": "demo-browser",
  "authenticationFlows": [
    {
      "alias": "demo-browser",
      "description": "Browser flow with email OTP as second factor",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "auth-cookie",                  "requirement": "ALTERNATIVE", "priority": 10, "autheticatorFlow": false, "userSetupAllowed": false },
        { "authenticator": "identity-provider-redirector", "requirement": "ALTERNATIVE", "priority": 25, "autheticatorFlow": false, "userSetupAllowed": false },
        { "flowAlias": "demo-browser forms",               "requirement": "ALTERNATIVE", "priority": 30, "autheticatorFlow": true,  "userSetupAllowed": false }
      ]
    },
    {
      "alias": "demo-browser forms",
      "description": "Username/password, then email OTP",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "auth-username-password-form", "requirement": "REQUIRED", "priority": 10, "autheticatorFlow": false, "userSetupAllowed": false },
        { "authenticator": "demo-email-otp",              "requirement": "REQUIRED", "priority": 20, "autheticatorFlow": false, "userSetupAllowed": false }
      ]
    }
  ],
  "components": {
    "org.keycloak.storage.UserStorageProvider": [
      {
        "name": "demo-user-provider",
        "providerId": "demo-user-provider",
        "subComponents": {},
        "config": {
          "enabled": ["true"],
          "priority": ["0"],
          "cachePolicy": ["NO_CACHE"]
        }
      }
    ]
  },
  "users": [],
  "clients": [
    {
      "clientId": "mfe-shell-client",
      "enabled": true,
      "name": "MFE Shell Client",
      "description": "Single OIDC client for the microfrontend shell (replaces app1/2/3-client).",
      "publicClient": true,
      "bearerOnly": false,
      "webOrigins": ["http://localhost:5173", "http://127.0.0.1:5173"],
      "redirectUris": ["http://localhost:5173/*", "http://127.0.0.1:5173/*"],
      "baseUrl": "http://localhost:5173/",
      "rootUrl": "http://localhost:5173",
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "protocolMappers": [
        {
          "name": "realm-roles-flat",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "app1-client",
      "enabled": false,
      "name": "App1 Client",
      "description": "Legacy per-app OIDC client. Disabled in the MFE migration — the shell uses mfe-shell-client instead. Kept in the realm for fast rollback; flip 'enabled' to true to revive the old 3-app demo.",
      "publicClient": true,
      "bearerOnly": false,
      "webOrigins": ["http://localhost:5173", "http://127.0.0.1:5173"],
      "redirectUris": ["http://localhost:5173/*", "http://127.0.0.1:5173/*"],
      "baseUrl": "http://localhost:5173/",
      "rootUrl": "http://localhost:5173",
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "attributes": { "login_theme": "app-a" },
      "protocolMappers": [
        {
          "name": "realm-roles-flat",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "app2-client",
      "enabled": false,
      "name": "App2 Client",
      "description": "Legacy per-app OIDC client. Disabled in the MFE migration — the shell uses mfe-shell-client instead. Kept in the realm for fast rollback.",
      "publicClient": true,
      "bearerOnly": false,
      "webOrigins": ["http://localhost:5174", "http://127.0.0.1:5174"],
      "redirectUris": ["http://localhost:5174/*", "http://127.0.0.1:5174/*"],
      "baseUrl": "http://localhost:5174/",
      "rootUrl": "http://localhost:5174",
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "attributes": { "login_theme": "app-b" },
      "protocolMappers": [
        {
          "name": "realm-roles-flat",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "app3-client",
      "enabled": false,
      "name": "App3 Client",
      "description": "Legacy per-app OIDC client. Disabled in the MFE migration — the shell uses mfe-shell-client instead. Kept in the realm for fast rollback.",
      "publicClient": true,
      "bearerOnly": false,
      "webOrigins": ["http://localhost:5175", "http://127.0.0.1:5175"],
      "redirectUris": ["http://localhost:5175/*", "http://127.0.0.1:5175/*"],
      "baseUrl": "http://localhost:5175/",
      "rootUrl": "http://localhost:5175",
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "attributes": { "login_theme": "app-c" },
      "protocolMappers": [
        {
          "name": "realm-roles-flat",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Standard user role"
      },
      {
        "name": "admin",
        "description": "Administrator role"
      },
      {
        "name": "client",
        "description": "Client role"
      }
    ]
  },

  "identityProviders": [
    {
      "alias": "p1",
      "displayName": "P1",
      "providerId": "saml",
      "enabled": true,
      "updateProfileFirstLoginMode": "on",
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "authenticateByDefault": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "singleSignOnServiceUrl": "http://host.docker.internal:8080/saml/idp/sso.do",
        "singleLogoutServiceUrl": "http://host.docker.internal:8080/saml/idp/slo.do",
        "nameIDPolicyFormat": "urn:oasis:names:tc:SAML:2.0:nameid-format:persistent",
        "principalType": "SUBJECT",
        "postBindingResponse": "true",
        "postBindingAuthnRequest": "true",
        "postBindingLogout": "true",
        "wantAssertionsSigned": "true",
        "wantAuthnRequestsSigned": "false",
        "validateSignature": "true",
        "signingCertificate": "PLACEHOLDER_REPLACED_WITH_P1_IDP_X509_AT_PHASE_2",
        "signatureAlgorithm": "RSA_SHA256",
        "xmlSigKeyInfoKeyNameTransformer": "NONE",
        "guiOrder": "10",
        "syncMode": "FORCE",
        "hideOnLoginPage": "false"
      }
    }
  ],

  "identityProviderMappers": [
    {
      "name": "email-from-saml",
      "identityProviderAlias": "p1",
      "identityProviderMapper": "saml-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "attribute.name": "email",
        "user.attribute": "email"
      }
    },
    {
      "name": "first-name-from-saml",
      "identityProviderAlias": "p1",
      "identityProviderMapper": "saml-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "attribute.name": "firstName",
        "user.attribute": "firstName"
      }
    },
    {
      "name": "last-name-from-saml",
      "identityProviderAlias": "p1",
      "identityProviderMapper": "saml-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "attribute.name": "lastName",
        "user.attribute": "lastName"
      }
    },
    {
      "name": "firm-cd-from-saml",
      "identityProviderAlias": "p1",
      "identityProviderMapper": "saml-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "attribute.name": "firmCd",
        "user.attribute": "firmCd"
      }
    },
    {
      "name": "roles-user-from-saml",
      "identityProviderAlias": "p1",
      "identityProviderMapper": "saml-role-idp-mapper",
      "config": {
        "syncMode": "FORCE",
        "attribute.name": "roles",
        "attribute.value": "user",
        "role": "user"
      }
    },
    {
      "name": "roles-client-from-saml",
      "identityProviderAlias": "p1",
      "identityProviderMapper": "saml-role-idp-mapper",
      "config": {
        "syncMode": "FORCE",
        "attribute.name": "roles",
        "attribute.value": "client",
        "role": "client"
      }
    },
    {
      "name": "roles-admin-from-saml",
      "identityProviderAlias": "p1",
      "identityProviderMapper": "saml-role-idp-mapper",
      "config": {
        "syncMode": "FORCE",
        "attribute.name": "roles",
        "attribute.value": "admin",
        "role": "admin"
      }
    }
  ]
}