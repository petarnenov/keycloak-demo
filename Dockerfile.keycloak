# Custom Keycloak image — stock KC 26.0.7 + bundled providers + theme.
#
# Build context: repo root.
# Stages:
#   1. spa-builder   — node, builds auth-spa/ (vite → theme/login/resources/js/auth-spa.js)
#   2. java-builder  — gradle, builds keycloak-providers/{user-storage-spi,email-otp-authenticator} jars
#   3. kc-builder    — stock KC 26.0.7, COPYs provider jars + theme dir, runs `kc.sh build`
#   4. runtime       — stock KC 26.0.7, COPYs the built /opt/keycloak from kc-builder

FROM node:20-alpine AS spa-builder
WORKDIR /build
COPY auth-spa/package.json auth-spa/package-lock.json* auth-spa/
RUN cd auth-spa && npm install --no-audit --no-fund
COPY auth-spa/ auth-spa/
RUN cd auth-spa && npm run build

FROM gradle:8.5-jdk17 AS java-builder
WORKDIR /build
COPY keycloak-providers/ keycloak-providers/
RUN cd keycloak-providers/user-storage-spi      && gradle --no-daemon jar -x test
RUN cd keycloak-providers/email-otp-authenticator && gradle --no-daemon jar -x test

FROM quay.io/keycloak/keycloak:26.0.7 AS kc-builder
USER root
# Provider JARs land in /opt/keycloak/providers/ — KC discovers them via the
# Java ServiceLoader entries in META-INF/services/*Factory.
COPY --from=java-builder /build/keycloak-providers/user-storage-spi/build/libs/*.jar      /opt/keycloak/providers/
COPY --from=java-builder /build/keycloak-providers/email-otp-authenticator/build/libs/*.jar /opt/keycloak/providers/
# Theme tree under /opt/keycloak/themes/<name>/ — KC discovers themes by dir.
# The auth-spa/theme/ root contains the login/ subfolder + META-INF/keycloak-themes.json
# (the latter doesn't matter for loose-dir themes but ships for parity with JAR themes).
COPY --from=spa-builder /build/auth-spa/theme/login/ /opt/keycloak/themes/geowealth/login/
RUN /opt/keycloak/bin/kc.sh build

FROM quay.io/keycloak/keycloak:26.0.7
COPY --from=kc-builder /opt/keycloak/ /opt/keycloak/
EXPOSE 8080
ENTRYPOINT ["/opt/keycloak/bin/kc.sh"]
CMD ["start-dev", "--import-realm", "--verbose"]
