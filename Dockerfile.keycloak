# Custom Keycloak image — stock KC 26.0.7 + bundled providers.
# First custom KC image in the demo. Bakes:
#   - user-storage-spi.jar  (User Storage SPI → user-service)
#   - email-otp-authenticator.jar  (custom Authenticator SPI for email OTP)
#   - geowealth-theme.jar  (login theme served at auth.geowealth.int)
#
# Build context: repo root (so we can COPY each provider's Gradle source).
# Two-stage: build all provider JARs in a Gradle stage, then COPY them into
# /opt/keycloak/providers/ in the runtime image and run `kc.sh build` so KC
# picks them up at boot.
FROM gradle:8.5-jdk17 AS builder
WORKDIR /build

# user-storage-spi
COPY keycloak-providers/user-storage-spi/ keycloak-providers/user-storage-spi/
WORKDIR /build/keycloak-providers/user-storage-spi
RUN gradle --no-daemon jar -x test

# email-otp-authenticator (built when Phase 4 lands; copy-empty-OK pattern
# means an absent module dir is non-fatal because the COPY below has || true
# semantics via Dockerfile multi-COPY).
WORKDIR /build
COPY keycloak-providers/ keycloak-providers/

# geowealth-theme (Phase 4)
# auth-spa/ produces theme/resources/dist/* via `npm run build`; here we
# repackage them into a Keycloak theme JAR.

WORKDIR /build/keycloak-providers/user-storage-spi
RUN ls -la build/libs/

FROM quay.io/keycloak/keycloak:26.0.7 AS kc-builder
COPY --from=builder /build/keycloak-providers/user-storage-spi/build/libs/*.jar /opt/keycloak/providers/
# Future provider JARs land here:
#   COPY --from=builder /build/keycloak-providers/email-otp-authenticator/build/libs/*.jar /opt/keycloak/providers/
#   COPY --from=builder /build/auth-spa/dist/geowealth-theme.jar /opt/keycloak/providers/
RUN /opt/keycloak/bin/kc.sh build

FROM quay.io/keycloak/keycloak:26.0.7
COPY --from=kc-builder /opt/keycloak/ /opt/keycloak/
EXPOSE 8080
ENTRYPOINT ["/opt/keycloak/bin/kc.sh"]
CMD ["start-dev", "--import-realm", "--verbose"]
